{
    "name": "apiverve/fullyqualifieddomain",
    "description": "Fully Qualified Domain resolves an IP address to its fully qualified domain name using reverse DNS PTR records. It returns the host FQDN, base domain, TLD, subdomain, and domain level count.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "fullyqualifieddomain",
        "fqdn api",
        "reverse dns lookup",
        "ip to fqdn",
        "ip to hostname",
        "ptr record lookup"
    ],
    "homepage": "https://apiverve.com/marketplace/fullyqualifieddomain?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/fullyqualifieddomain",
        "source": "https://github.com/apiverve/fullyqualifieddomain-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Fullyqualifieddomain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Fullyqualifieddomain\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
